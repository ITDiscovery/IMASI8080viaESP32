;
; HDSK.ASM
; ALTAIR 88-HDSK DRIVER FOR CP/M 2.2
;
; THIS DRIVER ADDS SUPPORT FOR THE 88-HDSK
; AT I/O PORTS 0A0H-0A3H AS DRIVE I:
;

; --- EQUATES ---
BDOS    EQU     0F206H  ; ADDRESS OF BDOS WARM BOOT ENTRY (FOR 56K SYSTEM)
HDSK_PORTA      EQU     0A0H    ; 4PIO PORT A (DATA/COMMAND)
HDSK_PORTA_C    EQU     0A1H    ; 4PIO PORT A (CONTROL)
HDSK_PORTB      EQU     0A2H    ; 4PIO PORT B (STATUS)
HDSK_PORTB_C    EQU     0A3H    ; 4PIO PORT B (CONTROL)

; --- HDSK COMMANDS ---
HDSK_READ       EQU     01H
HDSK_WRITE      EQU     02H
HDSK_SEEK       EQU     03H

; --- HDSK STATUS BITS ---
HDSK_STAT_BUSY  EQU     80H
HDSK_STAT_DRQ   EQU     02H
HDSK_STAT_ERR   EQU     01H

; --- 4PIO CONTROL ---
PIO_DDR_OUT     EQU     0FFH    ; SET 4PIO PORT TO OUTPUT
PIO_DDR_IN      EQU     00H     ; SET 4PIO PORT TO INPUT
PIO_RUN_MODE    EQU     04H     ; SET 4PIO TO RUN MODE

	ORG	0100H	; ALL .COM FILES START HERE

	JMP	HDSK_BOOT_CODE	; JUMP OVER DATA TO CODE

; ---------------------------------
; DATA AREA
; ---------------------------------

; --- DISK PARAMETER BLOCK ---
HDSK_DPB:
	DW	64	; SPT: 64 LOGICAL 128-BYTE SECTORS/TRACK
	DW	2048	; BSIZE: 2048-BYTE ALLOCATION BLOCKS
	DB	15	; BLM: (2048/128)-1 = 15
	DB	7	; EXM: EXTENT MASK = 7
	DW	560	; DSM: 560 BLOCKS (1.12MB)
	DW	255	; DRM: 256 DIRECTORY ENTRIES - 1
	DB	00H	; CKS: 0 (FIXED DISK)
	DB	00H	; (PADDING FOR CKS)
	DW	4	; OFF: 4 RESERVED TRACKS

; --- POINTERS TO ORIGINAL BIOS ---
O_BOOT:
	DW	0
O_WBOOT:
	DW	0
O_CONST:
	DW	0
O_CONIN:
	DW	0
O_CONOUT:
	DW	0
O_LIST:
	DW	0
O_PUNCH:
	DW	0
O_READER:
	DW	0
O_HOME:
	DW	0
O_SELDSK:
	DW	0
O_SETTRK:
	DW	0
O_SETSEC:
	DW	0
O_SETDMA:
	DW	0
O_READ:
	DW	0
O_WRITE:
	DW	0
O_LISTST:
	DW	0
O_SECTRAN:
	DW	0

; --- GLOBALS FOR HDSK DRIVER ---
HDSK_DRIVE:
	DB	0	; CURRENTLY SELECTED DRIVE (0-15)
HDSK_TRACK:
	DW	0	; CURRENTLY SELECTED TRACK
HDSK_SECTOR:
	DB	0	; CURRENTLY SELECTED SECTOR
HDSK_DMA:
	DW	80H	; CURRENT DMA ADDRESS

; ---------------------------------
; CODE AREA
; ---------------------------------
HDSK_BOOT_CODE:
; --- NEW BIOS JUMP TABLE ---
	JMP	HDSK_BOOT	; 0: BOOT
	JMP	HDSK_WBOOT	; 1: WBOOT
	JMP	HDSK_CONST	; 2: CONST
	JMP	HDSK_CONIN	; 3: CONIN
	JMP	HDSK_CONOUT	; 4: CONOUT
	JMP	HDSK_LIST	; 5: LIST
	JMP	HDSK_PUNCH	; 6: PUNCH
	JMP	HDSK_READER	; 7: READER
	JMP	HDSK_HOME	; 8: HOME
	JMP	HDSK_SELDSK	; 9: SELDSK
	JMP	HDSK_SETTRK	; 10: SETTRK
	JMP	HDSK_SETSEC	; 11: SETSEC
	JMP	HDSK_SETDMA	; 12: SETDMA
	JMP	HDSK_READ_ENTRY	; 13: READ
	JMP	HDSK_WRITE_ENTRY; 14: WRITE
	JMP	HDSK_LISTST	; 15: LISTST
	JMP	HDSK_SECTRAN	; 16: SECTRAN

; ---------------------------------
; NEW BIOS ROUTINES
; ---------------------------------
HDSK_BOOT:
	JMP	O_BOOT
HDSK_WBOOT:
	CALL	HDSK_INIT
	JMP	O_WBOOT
HDSK_CONST:
	JMP	O_CONST
HDSK_CONIN:
	JMP	O_CONIN
HDSK_CONOUT:
	JMP	O_CONOUT
HDSK_LIST:
	JMP	O_LIST
HDSK_PUNCH:
	JMP	O_PUNCH
HDSK_READER:
	JMP	O_READER
HDSK_LISTST:
	JMP	O_LISTST
HDSK_HOME:
	JMP	O_HOME

; --- SELDSK (SELECT DISK) ---
HDSK_SELDSK:
	MOV	A, C
	STA	HDSK_DRIVE
	CPI	8		; IS IT DRIVE I:?
	JNZ	HDSK_SEL_FLO
	LXI	H, HDSK_DPB	; YES, RETURN OUR DPB
	RET
HDSK_SEL_FLO:
	JMP	O_SELDSK

; --- SETTRK (SET TRACK) ---
HDSK_SETTRK:
	LDA	HDSK_DRIVE
	CPI	8
	JNZ	HDSK_SETTRK_FLO
	MOV	A, C
	STA	HDSK_TRACK
	MVI	A, 0
	STA	HDSK_TRACK+1
	RET
HDSK_SETTRK_FLO:
	JMP	O_SETTRK

; --- SETSEC (SET SECTOR) ---
HDSK_SETSEC:
	LDA	HDSK_DRIVE
	CPI	8
	JNZ	HDSK_SETSEC_FLO
	MOV	A, C
	STA	HDSK_SECTOR
	RET
HDSK_SETSEC_FLO:
	JMP	O_SETSEC

; --- SETDMA (SET DMA ADDRESS) ---
HDSK_SETDMA:
	MOV	A, B
	STA	HDSK_DMA+1
	MOV	A, C
	STA	HDSK_DMA
	JMP	O_SETDMA

; --- READ (ENTRY POINT) ---
HDSK_READ_ENTRY:
	LDA	HDSK_DRIVE
	CPI	8
	JNZ	HDSK_READ_FLO
	
	; --- SEND HDSK_CMD_READ (01H) ---
	MVI	A, HDSK_READ
	CALL	HDSK_SEND_CMD	; (RETURNS Z=1 ON ERROR)
	JNZ	HDSK_RD_ERR	; JUMP IF ERROR

	; --- TRANSFER 128 BYTES FROM CONTROLLER TO DMA ---
	LXI	H, 0		; HL = BYTE COUNTER
	LHLD	HDSK_DMA
	XCHG			; DE = DMA ADDRESS
HDSK_READ_LOOP:
	CALL	HDSK_WAIT_DRQ	; WAIT FOR DRQ
	JNZ	HDSK_RD_ERR	; TIMEOUT OR ERROR
	
	IN	HDSK_PORTA	; READ BYTE FROM DATA PORT
	STAX	D		; STORE BYTE AT [DE] (DMA ADDR)
	INX	D		; INCREMENT DMA ADDRESS
	
	INX	H		; INCREMENT BYTE COUNTER
	MOV	A, H		; CHECK IF WE'VE READ 128 BYTES
	CPI	80H		; (128 DECIMAL)
	JNZ	HDSK_READ_LOOP	; LOOP IF NOT DONE

	; --- WAIT FOR CONTROLLER TO GO IDLE ---
	CALL	HDSK_WAIT_READY
	JNZ	HDSK_RD_ERR	; TIMEOUT OR ERROR

	MVI	A, 0		; RETURN 0 = OK
	RET
HDSK_RD_ERR:
	MVI	A, 1		; RETURN 1 = ERROR
	RET
HDSK_READ_FLO:
	JMP	O_READ

; --- WRITE (ENTRY POINT) ---
HDSK_WRITE_ENTRY:
	LDA	HDSK_DRIVE
	CPI	8
	JNZ	HDSK_WRITE_FLO

	; --- SEND HDSK_CMD_WRITE (02H) ---
	MVI	A, HDSK_WRITE
	CALL	HDSK_SEND_CMD	; (RETURNS Z=1 ON ERROR)
	JNZ	HDSK_WR_ERR	; JUMP IF ERROR

	; --- TRANSFER 128 BYTES FROM DMA TO CONTROLLER ---
	LXI	H, 0		; HL = BYTE COUNTER
	LHLD	HDSK_DMA
	XCHG			; DE = DMA ADDRESS
HDSK_WRITE_LOOP:
	CALL	HDSK_WAIT_DRQ	; WAIT FOR DRQ
	JNZ	HDSK_WR_ERR	; TIMEOUT OR ERROR
	
	LDAX	D		; LOAD BYTE FROM [DE] (DMA ADDR)
	OUT	HDSK_PORTA	; WRITE BYTE TO DATA PORT
	INX	D		; INCREMENT DMA ADDRESS
	
	INX	H		; INCREMENT BYTE COUNTER
	MOV	A, H		; CHECK IF WE'VE WRITTEN 128 BYTES
	CPI	80H		; (128 DECIMAL)
	JNZ	HDSK_WRITE_LOOP	; LOOP IF NOT DONE

	; --- WAIT FOR CONTROLLER TO GO IDLE ---
	CALL	HDSK_WAIT_READY
	JNZ	HDSK_WR_ERR	; TIMEOUT OR ERROR

	MVI	A, 0		; RETURN 0 = OK
	RET
HDSK_WR_ERR:
	MVI	A, 1		; RETURN 1 = ERROR
	RET
HDSK_WRITE_FLO:
	JMP	O_WRITE

; --- SECTRAN (SECTOR TRANSLATE) ---
HDSK_SECTRAN:
	LDA	HDSK_DRIVE
	CPI	8
	JNZ	HDSK_SECTRAN_FLO
	MOV	A, C	; GET LOGICAL SECTOR
	MOV	L, A	; RETURN IT IN L
	RET
HDSK_SECTRAN_FLO:
	JMP	O_SECTRAN

; ---------------------------------
; HDSK HELPER ROUTINES
; ---------------------------------

; --- HDSK_INIT ---
HDSK_INIT:
	MVI	A, PIO_DDR_IN
	OUT	HDSK_PORTA
	MVI	A, PIO_RUN_MODE
	OUT	HDSK_PORTA_C
	MVI	A, PIO_DDR_IN
	OUT	HDSK_PORTB
	MVI	A, PIO_RUN_MODE
	OUT	HDSK_PORTB_C
	RET

; --- HDSK_WAIT_READY ---
HDSK_WAIT_READY:
	PUSH	B
	MVI	B, 0FFH
HDSK_WAIT_R_LOOP:
	IN	HDSK_PORTB
	ANI	HDSK_STAT_BUSY
	JZ	HDSK_WAIT_R_OK
	DJNZ	HDSK_WAIT_R_LOOP
	POP	B
	ORA	A		; SET Z=1 (ERROR)
	RET
HDSK_WAIT_R_OK:
	POP	B
	MVI	A, 1		; SET Z=0 (SUCCESS)
	RET

; --- HDSK_WAIT_DRQ ---
HDSK_WAIT_DRQ:
	PUSH	B
	MVI	B, 0FFH
HDSK_WAIT_D_LOOP:
	IN	HDSK_PORTB
	ANI	HDSK_STAT_ERR
	JNZ	HDSK_WAIT_D_ERR
	IN	HDSK_PORTB
	ANI	HDSK_STAT_DRQ
	JNZ	HDSK_WAIT_D_OK
	DJNZ	HDSK_WAIT_D_LOOP
HDSK_WAIT_D_ERR:
	POP	B
	ORA	A		; SET Z=1 (ERROR)
	RET
HDSK_WAIT_D_OK:
	POP	B
	MVI	A, 1		; SET Z=0 (SUCCESS)
	RET

; --- HDSK_SEND_CMD ---
HDSK_SEND_CMD:
	CALL	HDSK_WAIT_READY
	JNZ	HDSK_CMD_ERR
	OUT	HDSK_PORTA	; SEND COMMAND BYTE
	CALL	HDSK_WAIT_DRQ
	JNZ	HDSK_CMD_ERR
	LDA	HDSK_TRACK
	OUT	HDSK_PORTA	; SEND TRACK LOW
	CALL	HDSK_WAIT_DRQ
	JNZ	HDSK_CMD_ERR
	LDA	HDSK_TRACK+1
	OUT	HDSK_PORTA	; SEND TRACK HIGH
	CALL	HDSK_WAIT_DRQ
	JNZ	HDSK_CMD_ERR
	LDA	HDSK_SECTOR
	OUT	HDSK_PORTA	; SEND SECTOR
	MVI	A, 1		; SUCCESS (Z=0)
	RET
HDSK_CMD_ERR:
	ORA	A		; ERROR (Z=1)
	RET

	END

